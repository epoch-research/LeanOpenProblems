# Shared base: Lean v4.27.0 + Mathlib v4.27.0 (olean cache) + the
# FormalConjectures library, so that a problem file importing
# `FormalConjectures.Util.ProblemImports` compiles. The agent and scorer images
# both derive from this.
#
# Lean v4.27.0 matches the Formal Conjectures Erdős/OEIS datasets (oleans are
# version-specific, so the repl and SafeVerify are all built at this version).
#
#   docker build -t apn-lean-base -f Dockerfile.base .
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/root/.elan/bin:$PATH \
    ELAN_HOME=/root/.elan \
    APN_LEAN_PROJECT=/workspace/leanproject

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl git ca-certificates build-essential libgmp-dev \
        python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

ARG LEAN_VERSION=v4.27.0
RUN curl -sSfL https://elan.lean-lang.org/elan-init.sh -o elan-init.sh \
    && sh elan-init.sh -y --default-toolchain "leanprover/lean4:${LEAN_VERSION}" \
    && rm elan-init.sh

# Clone Formal Conjectures at a pinned commit on the auto_oeis branch (which
# carries both the FC library and the OEIS/Auto problem set). The problem files
# themselves are injected at runtime; we only need the library oleans here.
ARG FC_BRANCH=auto_oeis
ARG FC_COMMIT=67338a157bbb8d87e9a349d662f82a868bda6327
RUN git clone --filter=blob:none --branch "${FC_BRANCH}" \
        https://github.com/google-deepmind/formal-conjectures /workspace/leanproject \
    && git -C /workspace/leanproject checkout "${FC_COMMIT}"

WORKDIR /workspace/leanproject

# Fetch Mathlib's prebuilt oleans, then build only the ProblemImports closure
# (the FC Util/* support modules + FormalConjecturesForMathlib). The hundreds of
# problem files are NOT built.
RUN lake exe cache get \
    && lake build FormalConjectures.Util.ProblemImports

# Strip the problem files (every FormalConjectures/ subdir except the Util
# library) and the library test suite from the workspace. They are only needed to
# build the library closure above; leaving the problem files in would put the
# entire conjecture corpus -- other OEIS problems, and the Erdős/Arxiv/etc. sets
# which contain real proofs and axioms -- into every agent's sandbox, a
# benchmark-contamination vector. We keep the proving library itself (Util +
# FormalConjecturesForMathlib): it is imported into every problem's scope, so it
# is what the agent legitimately proves *with* (like Mathlib). Importing
# `FormalConjectures.Util.ProblemImports` still resolves via the built oleans.
RUN find FormalConjectures -mindepth 1 -maxdepth 1 -type d ! -name Util \
        -exec rm -rf {} + \
    && rm -rf FormalConjecturesTest

CMD ["sleep", "infinity"]
